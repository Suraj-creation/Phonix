# Phoenix Club — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# ------------------------------------------------------------------------------
# Google Sheets registration mirror
# ------------------------------------------------------------------------------
# Every confirmed registration is also appended to the club spreadsheet.
# Deploy google-sheets-webapp.gs as a Web App (steps are in that file's header),
# then paste its /exec URL here.
#
# Leave SHEETS_WEBHOOK_URL blank to disable the mirror entirely — registrations
# still save to SQLite as normal.
SHEETS_WEBHOOK_URL=""

# Must match SHARED_SECRET inside google-sheets-webapp.gs.
# Use any long random string; it stops strangers writing rows to your sheet.
SHEETS_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Flask session signing (app.py)
# ------------------------------------------------------------------------------
# Set this in production. The built-in fallback is a shared development value.
FLASK_SECRET_KEY=""
